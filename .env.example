# keyrad environment variables - EXAMPLE FILE
#
# Copy this to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored; this .env.example is meant to be committed.
#
# keyrad itself does NOT read .env. Use it from Docker Compose (env_file: / ${VAR})
# or load it into your shell before starting the daemon:
#   set -a; source .env; set +a
#
# Precedence: environment variables WIN over keyrad.yaml, so keyrad.yaml can be
# committed or baked into an image with its credentials left empty ("") or as the
# "<>" placeholder.
#
# Booleans accept true/false/1/0 (anything else aborts startup with an error).
# Settings without a KEYRAD_* variable below - listen_addr, otp_challenge_message,
# scope_radius_map - and the RADIUS client definitions can only come from
# keyrad.yaml / clients.conf. Server flags (-c, -r, --debug, --pap,
# --disable-challenge-response, --disable-message-authenticator, --version) are
# command-line only.

# ---------------------------------------------------------------------------
# Keycloak - required
# ---------------------------------------------------------------------------
# All five are required: if any is missing (empty or still containing "<>"),
# keyrad refuses to start instead of running half-configured.

# Confidential client ID that keyrad authenticates with.
KEYRAD_KEYCLOAK_CLIENT_ID=keyrad

# Client secret of that confidential client. Never commit the real value.
KEYRAD_KEYCLOAK_CLIENT_SECRET=replace-with-client-secret

# OIDC token endpoint. Must be a complete URL that already contains the realm;
# keyrad never inserts KEYRAD_KEYCLOAK_REALM into it.
KEYRAD_KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/your-realm/protocol/openid-connect/token

# Keycloak realm name (reported at startup; not substituted into the URLs).
KEYRAD_KEYCLOAK_REALM=your-realm

# Keycloak Admin REST API base URL, including the realm.
KEYRAD_KEYCLOAK_API_URL=https://keycloak.example.com/admin/realms/your-realm

# ---------------------------------------------------------------------------
# Keycloak - optional
# ---------------------------------------------------------------------------

# true/false, default false. Skips TLS certificate verification for Keycloak.
# DANGER: with this on, a network MITM can read the client secret and user
# passwords. Only for self-signed certs in a trusted network; keyrad logs a
# warning at startup.
#KEYRAD_KEYCLOAK_INSECURE_SKIP_TLS_VERIFY=false

# ---------------------------------------------------------------------------
# OTP-only flow - optional
# ---------------------------------------------------------------------------

# true/false, default false. Requires the --disable-challenge-response flag:
# User-Password then carries only the 6-character OTP and an empty password is
# sent to Keycloak. Without that flag keyrad refuses to start. Global for all
# clients and users; the Keycloak Direct Grant flow must skip the password step.
#KEYRAD_ALLOW_OTP_ONLY=false

# true/false, default false. Only valid together with KEYRAD_ALLOW_OTP_ONLY=true:
# answer Access-Reject for users without an OTP credential (or when the OTP
# lookup fails) instead of falling back to the plain password grant.
#KEYRAD_OTP_ONLY_REJECT_NON_OTP=false

# ---------------------------------------------------------------------------
# RADIUS client shared secrets - optional per-client overrides
# ---------------------------------------------------------------------------
# Clients can only be *defined* in clients.conf; the environment only replaces
# their shared secret.
#
# Variable name: KEYRAD_RADIUS_CLIENT_SECRET_<CLIENT_KEY>
# <CLIENT_KEY> is the client's ipaddr (or its block name when ipaddr is absent),
# uppercased, with ".", ":", "/", "-" and spaces replaced by "_":
#   client 127.0.0.1    { ... } -> KEYRAD_RADIUS_CLIENT_SECRET_127_0_0_1
#   client 10.0.0.0/24  { ... } -> KEYRAD_RADIUS_CLIENT_SECRET_10_0_0_0_24
#   client nas-1        { ... } -> KEYRAD_RADIUS_CLIENT_SECRET_NAS_1
#
#KEYRAD_RADIUS_CLIENT_SECRET_127_0_0_1=testing123
#KEYRAD_RADIUS_CLIENT_SECRET_10_0_0_0_24=replace-with-shared-secret
